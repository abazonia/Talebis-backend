# ─── TALEBIS BACKEND ENVIRONMENT VARIABLES ───────────────────
# Copy this into Railway as environment variables
# Never share these keys with anyone

PORT=5000
NODE_ENV=production
FRONTEND_URL=https://talebis.ng

# Generate this by running in terminal:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING

# From supabase.com → Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# From console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# From paystack.com → Settings → API Keys
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret

# From upstash.com → Your database → REST API
UPSTASH_REDIS_URL=https://...upstash.io
UPSTASH_REDIS_TOKEN=your_token_here

# From resend.com → API Keys
RESEND_API_KEY=re_...
FROM_EMAIL=hello@talebis.ng

# Create your own secret admin password
ADMIN_SECRET_KEY=talebis_admin_secret_2024
